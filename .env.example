# Copy to .env and fill in. Get a key at https://cloud.maptiler.com/account/keys/
#
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time, which means
# anyone with the shipped app can read this key. That is how MapTiler client keys
# are meant to work, but restrict it in the dashboard and watch its usage.
EXPO_PUBLIC_MAPTILER_KEY=
